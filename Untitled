cat << 'EOF' > app/page.tsx
"use client";

import { useEffect, useState } from "react";
import { createClient } from "@supabase/supabase-js";

const supabase = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL!,
  process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!
);

interface CallRecord {
  id: string;
  vapi_call_id: string | null;
  scenario_type: string | null;
  target_name: string | null;
  target_phone: string;
  mission_order: string;
  status: string;
  summary_ko: string | null;
  duration_seconds: number | null;
  cost_usd: number | null;
  created_at: string;
}

interface CallMessage {
  id: string;
  call_id: string;
  speaker: "ai" | "remote";
  transcript_en: string;
  translation_ko: string | null;
  created_at: string;
}

export default function HomePage() {
  const [scenarioType, setScenarioType] = useState("medical_booking");
  const [targetName, setTargetName] = useState("");
  const [targetPhone, setTargetPhone] = useState("");
  const [missionOrder, setMissionOrder] = useState("");
  const [submitting, setSubmitting] = useState(false);
  const [errorMsg, setErrorMsg] = useState("");

  const [calls, setCalls] = useState<CallRecord[]>([]);
  const [selectedCallId, setSelectedCallId] = useState<string | null>(null);
  const [messages, setMessages] = useState<CallMessage[]>([]);

  async function loadCalls() {
    const { data } = await supabase
      .from("calls")
      .select("*")
      .order("created_at", { ascending: false })
      .limit(20);

    if (data && data.length > 0) {
      setCalls(data);
      setSelectedCallId((prev) => prev ?? data[0].id);
    }
  }

  async function loadMessages(callId: string) {
    const { data } = await supabase
      .from("call_messages")
      .select("*")
      .eq("call_id", callId)
      .order("created_at", { ascending: true });

    setMessages(data ?? []);
  }

  useEffect(() => {
    loadCalls();

    const callsChannel = supabase
      .channel("calls-realtime")
      .on(
        "postgres_changes",
        { event: "*", schema: "public", table: "calls" },
        () => {
          loadCalls();
        }
      )
      .subscribe();

    return () => {
      supabase.removeChannel(callsChannel);
    };
  }, []);

  useEffect(() => {
    if (!selectedCallId) return;
    loadMessages(selectedCallId);

    const msgChannel = supabase
      .channel(`messages-${selectedCallId}`)
      .on(
        "postgres_changes",
        {
          event: "INSERT",
          schema: "public",
          table: "call_messages",
          filter: `call_id=eq.${selectedCallId}`,
        },
        (payload) => {
          setMessages((prev) => [...prev, payload.new as CallMessage]);
        }
      )
      .subscribe();

    return () => {
      supabase.removeChannel(msgChannel);
    };
  }, [selectedCallId]);

  async function handleStartCall(e: React.FormEvent) {
    e.preventDefault();
    setErrorMsg("");
    if (!targetPhone.trim() || !missionOrder.trim()) {
      setErrorMsg("수신 전화번호와 요청 내용을 입력해 주세요.");
      return;
    }

    setSubmitting(true);
    try {
      const res = await fetch("/api/call/start", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          scenarioType,
          targetName: targetName.trim(),
          targetPhone: targetPhone.trim(),
          missionOrder: missionOrder.trim(),
        }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) {
        setErrorMsg(data.error || "발신 요청에 실패했습니다.");
      } else {
        setMissionOrder("");
        if (data.call?.id) {
          setSelectedCallId(data.call.id);
        }
        await loadCalls();
      }
    } catch {
      setErrorMsg("네트워크 오류가 발생했습니다.");
    } finally {
      setSubmitting(false);
    }
  }

  const selectedCall = calls.find((c) => c.id === selectedCallId) ?? null;

  return (
    <main className="min-h-screen bg-slate-950 text-slate-100 p-6">
      <div className="max-w-6xl mx-auto space-y-6">
        <header className="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-4">
          <div>
            <h1 className="text-2xl font-bold tracking-tight">CallForMe 대시보드</h1>
            <p className="text-sm text-slate-400">
              AI 전화 발신 요청 · 실시간 영한 자막 · 통화 결과 요약
            </p>
          </div>
          <span className="text-xs px-3 py-1 rounded-full bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
            Dongwoo Go 프로필 연동됨
          </span>
        </header>

        <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
          <section className="lg:col-span-5 bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-4">
            <h2 className="text-lg font-semibold">새 통화 미션 발신</h2>

            <form onSubmit={handleStartCall} className="space-y-4">
              <div>
                <label className="block text-xs text-slate-400 mb-1">시나리오 유형</label>
                <select
                  value={scenarioType}
                  onChange={(e) => setScenarioType(e.target.value)}
                  className="w-full rounded-xl bg-slate-950 border border-slate-700 px-3 py-2 text-sm"
                >
                  <option value="medical_booking">병원 예약</option>
                  <option value="reschedule_cancel">일정 변경 및 취소</option>
                  <option value="restaurant_booking">레스토랑 예약</option>
                  <option value="general_inquiry">일반 문의 및 확인</option>
                </select>
              </div>

              <div>
                <label className="block text-xs text-slate-400 mb-1">상대 기관 및 업체명</label>
                <input
                  type="text"
                  value={targetName}
                  onChange={(e) => setTargetName(e.target.value)}
                  placeholder="예: Richmond Family Clinic"
                  className="w-full rounded-xl bg-slate-950 border border-slate-700 px-3 py-2 text-sm"
                />
              </div>

              <div>
                <label className="block text-xs text-slate-400 mb-1">수신 전화번호</label>
                <input
                  type="text"
                  value={targetPhone}
                  onChange={(e) => setTargetPhone(e.target.value)}
                  placeholder="예: +17782312322 또는 7782312322"
                  className="w-full rounded-xl bg-slate-950 border border-slate-700 px-3 py-2 text-sm"
                />
              </div>

              <div>
                <label className="block text-xs text-slate-400 mb-1">요청 내용(미션 오더)</label>
                <textarea
                  rows={4}
                  value={missionOrder}
                  onChange={(e) => setMissionOrder(e.target.value)}
                  placeholder="예: 다음 주 화요일 오전 일반 검진 예약 및 혈액검사 의뢰서 문의"
                  className="w-full rounded-xl bg-slate-950 border border-slate-700 px-3 py-2 text-sm"
                />
              </div>

              {errorMsg && (
                <p className="text-xs text-rose-400 bg-rose-500/10 border border-rose-500/30 rounded-lg p-2.5">
                  {errorMsg}
                </p>
              )}

              <button
                type="submit"
                disabled={submitting}
                className="w-full py-2.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 disabled:opacity-50 font-medium text-sm transition"
              >
                {submitting ? "발신 요청 중..." : "전화 걸기 시작"}
              </button>
            </form>

            <div className="pt-3 border-t border-slate-800 space-y-2">
              <h3 className="text-xs font-semibold text-slate-400">최근 통화 목록</h3>
              <div className="space-y-2 max-h-60 overflow-y-auto">
                {calls.length === 0 ? (
                  <p className="text-xs text-slate-500">아직 기록된 통화가 없습니다.</p>
                ) : (
                  calls.map((c) => (
                    <button
                      key={c.id}
                      type="button"
                      onClick={() => setSelectedCallId(c.id)}
                      className={`w-full text-left p-3 rounded-xl border text-xs transition ${
                        c.id === selectedCallId
                          ? "bg-slate-800 border-indigo-500"
                          : "bg-slate-950 border-slate-800 hover:border-slate-700"
                      }`}
                    >
                      <div className="flex justify-between items-center">
                        <span className="font-semibold text-slate-200">
                          {c.target_name || c.target_phone}
                        </span>
                        <span className="px-2 py-0.5 rounded bg-slate-800 text-slate-300">
                          {c.status}
                        </span>
                      </div>
                      <p className="text-slate-400 truncate mt-1">{c.mission_order}</p>
                    </button>
                  ))
                )}
              </div>
            </div>
          </section>

          <section className="lg:col-span-7 space-y-6">
            <div className="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-3">
              <div className="flex items-center justify-between">
                <h2 className="text-lg font-semibold">실시간 영문·한글 자막</h2>
                <span className="text-xs text-slate-400">
                  {